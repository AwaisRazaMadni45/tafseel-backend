# MongoDB connection string (MongoDB Atlas ya local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tafseel

# JWT secret for admin auth tokens
JWT_SECRET=change_this_to_a_long_random_string

# Server port
PORT=5000

# Used ONLY by createFirstAdmin.js to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SECRET_KEY=
# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
